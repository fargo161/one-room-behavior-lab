{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trapstar.invalid/schemas/dialogue_node.schema.json",
  "title": "Dialogue Node",
  "type": "object",
  "required": [
    "dialogue_id",
    "node_id",
    "speaker_character_id",
    "text",
    "choices",
    "preconditions"
  ],
  "properties": {
    "dialogue_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "speaker_character_id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string"
    },
    "expression_or_pose_hook": {
      "type": [
        "string",
        "null"
      ]
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "next_dialogue_node": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
