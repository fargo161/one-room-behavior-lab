{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trapstar.invalid/schemas/inventory.schema.json",
  "title": "Inventory",
  "type": "object",
  "required": [
    "owner_id",
    "entries"
  ],
  "properties": {
    "owner_id": {
      "type": "string",
      "minLength": 1
    },
    "capacity": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "quantity"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "additionalProperties": true
}
