{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trapstar.invalid/schemas/pause_menu.schema.json",
  "title": "Pause Menu",
  "type": "object",
  "required": [
    "menu_id",
    "entries"
  ],
  "properties": {
    "menu_id": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entry_id",
          "label",
          "implementation_status"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "implementation_status": {
            "const": "PLACEHOLDER_CONTRACT_ONLY"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
